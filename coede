
# Code Analyzer Pro Plus
# AST 기반 Python 코드 품질 분석 및 개선 도구

import tkinter as tk
from tkinter import filedialog, messagebox
import ast
import matplotlib.pyplot as plt
import matplotlib

matplotlib.rcParams['font.family'] = 'Malgun Gothic'
matplotlib.rcParams['axes.unicode_minus'] = False


class CodeAnalyzer:

    def __init__(self, root):
        self.root = root
        self.root.title("Code Analyzer Pro Plus")
        self.root.geometry("950x750")

        self.file_path = ""
        self.stats = {}
        self.report_text = ""
        self.source_code = ""

        tk.Label(
            root,
            text="AST 기반 Python 코드 품질 분석기",
            font=("Arial", 20, "bold")
        ).pack(pady=10)

        self.file_label = tk.Label(
            root,
            text="선택된 파일 없음"
        )
        self.file_label.pack()

        tk.Button(root, text="파일 열기", command=self.open_file, width=25).pack(pady=3)
        tk.Button(root, text="코드 분석", command=self.analyze_code, width=25).pack(pady=3)
        tk.Button(root, text="그래프 보기", command=self.show_graph, width=25).pack(pady=3)
        tk.Button(root, text="코드 개선 제안", command=self.show_improvements, width=25).pack(pady=3)
        tk.Button(root, text="분석 결과 저장", command=self.save_report, width=25).pack(pady=3)

        self.result_text = tk.Text(root, width=110, height=35)
        self.result_text.pack(pady=10)

    def open_file(self):
        path = filedialog.askopenfilename(
            filetypes=[("Python Files", "*.py")]
        )

        if path:
            self.file_path = path
            self.file_label.config(text=path)

    def analyze_code(self):

        if not self.file_path:
            messagebox.showwarning("경고", "먼저 파일을 선택하세요.")
            return

        try:

            with open(self.file_path, "r", encoding="utf-8") as f:
                source = f.read()

            self.source_code = source

            tree = ast.parse(source)

            functions = sum(
                isinstance(node, ast.FunctionDef)
                for node in ast.walk(tree)
            )

            classes = sum(
                isinstance(node, ast.ClassDef)
                for node in ast.walk(tree)
            )

            ifs = sum(
                isinstance(node, ast.If)
                for node in ast.walk(tree)
            )

            fors = sum(
                isinstance(node, ast.For)
                for node in ast.walk(tree)
            )

            whiles = sum(
                isinstance(node, ast.While)
                for node in ast.walk(tree)
            )

            trys = sum(
                isinstance(node, ast.Try)
                for node in ast.walk(tree)
            )

            imports = sum(
                isinstance(node, (ast.Import, ast.ImportFrom))
                for node in ast.walk(tree)
            )

            total_lines = len(source.splitlines())

            complexity = ifs + fors + whiles + trys + 1

            score = (
                functions * 2 +
                classes * 3 +
                imports +
                10
            )

            score = min(score * 2, 100)

            if score >= 90:
                grade = "A"
                comment = "매우 우수한 코드 구조입니다."
            elif score >= 75:
                grade = "B"
                comment = "좋은 코드 구조입니다."
            elif score >= 60:
                grade = "C"
                comment = "보통 수준입니다."
            else:
                grade = "D"
                comment = "구조 개선이 필요합니다."

            self.stats = {
                "함수": functions,
                "클래스": classes,
                "조건문": ifs,
                "for문": fors,
                "while문": whiles,
                "try": trys,
                "import": imports
            }

            result = f"""
==============================
      코드 분석 결과
==============================

총 코드 줄 수 : {total_lines}

함수 개수 : {functions}
클래스 개수 : {classes}

조건문 개수 : {ifs}
for문 개수 : {fors}
while문 개수 : {whiles}

try-except 개수 : {trys}

import 개수 : {imports}

------------------------------

코드 복잡도 : {complexity}

코드 점수 : {score}/100

코드 품질 등급 : {grade}

평가 :
{comment}

------------------------------
"""

            self.result_text.delete("1.0", tk.END)
            self.result_text.insert(tk.END, result)

            self.report_text = result

        except Exception as e:
            messagebox.showerror("오류", str(e))

    def show_improvements(self):

        if not self.source_code:
            messagebox.showwarning("경고", "먼저 코드를 분석하세요.")
            return

        tree = ast.parse(self.source_code)

        suggestions = []

        # 클래스 사용 여부
        classes = sum(
            isinstance(node, ast.ClassDef)
            for node in ast.walk(tree)
        )

        if classes == 0:
            suggestions.append(
                "클래스를 사용하면 유지보수성이 향상됩니다."
            )

        # 함수 길이 검사
        for node in ast.walk(tree):

            if isinstance(node, ast.FunctionDef):

                if hasattr(node, "end_lineno"):

                    length = node.end_lineno - node.lineno

                    if length > 30:
                        suggestions.append(
                            f"함수 '{node.name}'가 너무 깁니다. 분리하는 것을 추천합니다."
                        )

        # try 검사
        try_count = sum(
            isinstance(node, ast.Try)
            for node in ast.walk(tree)
        )

        if "open(" in self.source_code and try_count == 0:
            suggestions.append(
                "파일 입출력에 예외처리(try-except)를 추가하는 것이 좋습니다."
            )

        # 중복 print 탐지
        lines = self.source_code.splitlines()

        repeated = []

        for line in set(lines):
            if line.strip().startswith("print("):
                count = lines.count(line)
                if count >= 3:
                    repeated.append(line.strip())

        if repeated:
            suggestions.append(
                "동일한 print문이 반복됩니다. 반복문 사용을 고려해보세요."
            )

        if not suggestions:
            suggestions.append(
                "특별한 개선 사항이 발견되지 않았습니다."
            )

        self.result_text.insert(
            tk.END,
            "\n\n========== 코드 개선 제안 ==========\n\n"
        )

        for item in suggestions:
            self.result_text.insert(tk.END, f"• {item}\n")

    def show_graph(self):

        if not self.stats:
            messagebox.showwarning(
                "경고",
                "먼저 분석을 실행하세요."
            )
            return

        labels = list(self.stats.keys())
        values = list(self.stats.values())

        plt.figure(figsize=(8, 5))
        plt.bar(labels, values)

        plt.title("파이썬 코드 분석 결과")
        plt.xlabel("항목")
        plt.ylabel("개수")

        plt.tight_layout()
        plt.show()

    def save_report(self):

        content = self.result_text.get("1.0", tk.END)

        if not content.strip():
            messagebox.showwarning(
                "경고",
                "저장할 내용이 없습니다."
            )
            return

        path = filedialog.asksaveasfilename(
            defaultextension=".txt",
            filetypes=[("Text File", "*.txt")]
        )

        if not path:
            return

        with open(path, "w", encoding="utf-8") as f:
            f.write(content)

        messagebox.showinfo(
            "완료",
            "분석 결과가 저장되었습니다."
        )


root = tk.Tk()
app = CodeAnalyzer(root)
root.mainloop()
